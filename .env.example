# Ambiente: development ou production
APP_ENV=development
SEED_DEMO_DATA=true
DATABASE_PATH=./northmen.db

# Administração — altere antes de publicar
ADMIN_USERNAME=seu_usuario_admin
ADMIN_PASSWORD=coloque_uma_senha_forte_e_unica
STORE_SECRET=gere_um_segredo_aleatorio_com_32_caracteres_ou_mais

# URL pública HTTPS da loja (obrigatória para pagamento online)
PUBLIC_BASE_URL=https://www.seudominio.com.br

# Mercado Pago Developers > Sua integração
MERCADOPAGO_ACCESS_TOKEN=APP_USR_seu_access_token
MERCADOPAGO_WEBHOOK_SECRET=sua_assinatura_secreta_webhook

# Melhor Envio > Integrações > API
MELHORENVIO_ENV=sandbox
MELHORENVIO_TOKEN=seu_token_melhor_envio
STORE_ORIGIN_CEP=00000000
STORE_USER_AGENT=NORTHMEN Store (suporte@seudominio.com.br)
STORE_PACKAGE_WIDTH_CM=20
STORE_PACKAGE_HEIGHT_CM=8
STORE_PACKAGE_LENGTH_CM=30
STORE_PRODUCT_WEIGHT_KG=0.4
